# =============================================================================
# GiveSphere Platform - Environment Configuration Example
# =============================================================================
# Duplicate this file to .env.local for local development.
# Do NOT commit actual secrets or production keys to version control.
# =============================================================================

# Backend REST API Base URL
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Frontend Application URL
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# Razorpay Payment Gateway Key ID (Test key for local development)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
